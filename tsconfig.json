{
    "compilerOptions": {
        "target": "es2022",
        "lib": ["dom", "dom.iterable", "esnext"],
        "allowJs": true,
        "skipLibCheck": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "preserve",
        "incremental": true,
        "plugins": [
            {
                "name": "next"
            }
        ],
        "baseUrl": "src",
        "paths": {
            "posthog-js": ["./lib/posthog-disabled"],
            "posthog-js/react": ["./lib/posthog-disabled-react"],
            "@/*": ["./*"]
        },
        "types": ["node", "babel__generator", "react"]
    },
    "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", "src", ".next/types/**/*.ts"],
    "exclude": ["node_modules", "./functions"]
}
