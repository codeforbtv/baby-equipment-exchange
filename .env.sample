# local emulator dev only needs projectId. must match value used by *emulators* script in `package.json`.
# in prod (Firebase App Hosting), FIREBASE_WEBAPP_CONFIG is auto-injected at build time so no client config vars needed.
NEXT_PUBLIC_FIREBASE_PROJECT_ID="baby-equipment-exchange-dev"

